# Defensive TERM guard for nested terminal sessions (tmux-in-Terminal.app,
# some SSH scenarios) where TERM arrives unset or as "dumb", which breaks
# colors and clear-screen escapes.
if [[ -z "${TERM:-}" || "$TERM" == "dumb" ]]; then
    export TERM=xterm-256color
fi

# Oh My Zsh — framework + theme.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Keep OMZ up to date without the periodic interactive prompt.
# OMZ changed its default to 'reminder' (prompts) around 2022; this
# restores the pre-2022 silent-background behavior.
zstyle ':omz:update' mode auto

plugins=(
    aws
    colored-man-pages
    command-not-found
    docker
    docker-compose
    git
    gradle
    helm
    history-substring-search
    kubectl
    man
    mise
    mvn
)

source $ZSH/oh-my-zsh.sh

# Personal PATH additions.
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

# GNU coreutils unprefixed on PATH (date, realpath, stat, sort -V, ...).
# Required by git-quick-stats (needs GNU date); handy for any script that
# relies on GNU semantics. Both prefixes listed because only one exists
# per architecture (/opt/homebrew on Apple Silicon, /usr/local on Intel);
# zsh silently skips a non-existent entry.
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:/usr/local/opt/coreutils/libexec/gnubin:$PATH"

# mise — polyglot runtime manager (https://mise.jdx.dev).
eval "$(mise activate zsh)"

# direnv — per-directory environment variables via .envrc.
eval "$(direnv hook zsh)"

# pipx — isolated per-tool Python envs on PATH, with bash-style completion.
export PATH="$PATH:$HOME/.local/bin"
autoload -U bashcompinit
bashcompinit

# Rancher Desktop CLI binaries (nerdctl, kubectl shim, helm shim).
export PATH="$HOME/.rd/bin:$PATH"
